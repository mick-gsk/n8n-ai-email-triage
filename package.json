{
  "name": "n8n-ai-workflows",
  "version": "1.0.0",
  "description": "A collection of production-ready n8n workflows with AI steps: email triage, and more, each tested and checked against a real n8n instance.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs shared/*/test/*.test.mjs workflows/*/test/*.test.mjs",
    "lint": "eslint . && prettier --check \"lib/**/*.mjs\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"workflows/**/*.{js,mjs,ts}\" \"shared/**/*.{js,mjs,ts}\" eslint.config.js",
    "format": "prettier --write \"lib/**/*.mjs\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"workflows/**/*.{js,mjs,ts}\" \"shared/**/*.{js,mjs,ts}\" eslint.config.js",
    "typecheck": "tsc -p .",
    "eval:email-triage": "node workflows/email-triage/eval/run.mjs",
    "check:n8n": "node scripts/check-n8n.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
