{
  "name": "n8n-ai-email-triage",
  "version": "1.0.0",
  "description": "n8n workflow that sorts Gmail with Claude: labels, Slack alerts for urgent mail, reply drafts and a Google Sheets log.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build-workflow.mjs",
    "test": "node scripts/build-workflow.mjs && node --test test/*.test.mjs",
    "lint": "eslint . && prettier --check \"src/**/*.js\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"eval/**/*.mjs\" eslint.config.js",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"eval/**/*.mjs\" eslint.config.js",
    "eval": "node eval/run.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "prettier": "3.9.10"
  }
}
